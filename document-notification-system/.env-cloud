# ============================================================
# Variables para el despliegue en Azure (Container Apps)
# Guia: docs/AZURE-ESTUDIANTE-PASO-A-PASO.md
# Referencia completa de variables: docs/DEPLOYMENT.md
#
# ⚠️ Esta plantilla se versiona con valores VACIOS.
#    Cuando la llenes con credenciales reales, NO comitees esos
#    cambios. En Container Apps, los valores marcados como SECRETO
#    deben ir como secreto (--secrets + secretref:), no en texto plano.
# ============================================================

# --- Azure: nombres de recursos (pasos 3, 5, 7 y 8 de la guia) ---
RESOURCE_GROUP=
LOCATION=eastus
ACR_NAME=
CONTAINERAPPS_ENV=
PG_SERVER_NAME=

# --- Base de datos: PostgreSQL Flexible Server (paso 5) ---
# DB_HOST tiene la forma <PG_SERVER_NAME>.postgres.database.azure.com
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
POSTGRES_USER=
POSTGRES_PASSWORD=          # SECRETO (pgpass)
DB_EXTRA_PARAMS=&sslmode=require
# 'always' SOLO en el primer arranque de customer-service; luego 'never'
SQL_INIT_MODE=never

# --- Kafka: Confluent Cloud (paso 6) ---
# Bootstrap con forma pkc-xxxxx.eastus.azure.confluent.cloud:9092
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=PLAIN
# Cadena JAAS completa con la API key/secret del CLUSTER:
# org.apache.kafka.common.security.plain.PlainLoginModule required username="<KEY>" password="<SECRET>";
KAFKA_SASL_JAAS_CONFIG=     # SECRETO (kafkajaas)

# --- Schema Registry: Confluent Cloud (paso 6.4/6.5) ---
# URL con forma https://psrc-xxxxx.eastus.azure.confluent.cloud
SCHEMA_REGISTRY_URL=
# Formato <SR_KEY>:<SR_SECRET> (API key propia del Schema Registry)
SCHEMA_REGISTRY_AUTH_USER_INFO=   # SECRETO (srauth)

# --- Correo: Azure Communication Services (paso 7) ---
# MAIL_PROVIDER puede omitirse: 'azure' es el default de la aplicacion
MAIL_PROVIDER=azure
ACS_CONNECTION_STRING=      # SECRETO (acsconn) — obligatorio con provider azure
# Remitente del dominio verificado de ACS: donotreply@<guid>.azurecomm.net
MAIL_FROM=
# Rate limiter: con ACS se puede subir (ej. 20 tokens / 1000 ms)
MAIL_RATE_LIMIT_TOKENS=20
MAIL_RATE_LIMIT_REFILL_MS=1000

# --- Operacion ---
APP_LOG_LEVEL=INFO
JPA_SHOW_SQL=false

# --- Escalado (solo si subes replicas; ver seccion de escalado) ---
# Unico por instancia de notification-service (locking del outbox):
# NOTIFICATION_INSTANCE_ID=
# Pool por replica si te quedas en la BD B1ms (~35 conexiones max):
# SPRING_DATASOURCE_HIKARI_MAXIMUMPOOLSIZE=5
