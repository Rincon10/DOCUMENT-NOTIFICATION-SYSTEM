# ============================================================
# Variables para el despliegue en Azure (Container Apps)
# Guia: docs/AZURE-ESTUDIANTE-PASO-A-PASO.md
# Referencia completa de variables: docs/DEPLOYMENT.md
#
# ⚠️ Esta plantilla se versiona con valores VACIOS.
#    Cuando la llenes con credenciales reales, NO comitees esos
#    cambios. En Container Apps, los valores marcados como SECRETO
#    deben ir como secreto (--secrets + secretref:), no en texto plano.
#
# Formato: los valores con ';', espacios o '#' (la connection string
# de ACS y la cadena JAAS de Kafka) van ENTRE COMILLAS SIMPLES:
#   ACS_CONNECTION_STRING='endpoint=https://...;accesskey=...'
# Asi el archivo se puede cargar en la terminal (guia, seccion 7.5):
#   Bash:       set -a; source .env-cloud; set +a
#   PowerShell: ver snippet de la seccion 7.5 de la guia
# ============================================================

# --- Azure: nombres de recursos (pasos 3, 5, 7 y 8 de la guia) ---
RESOURCE_GROUP=
LOCATION=eastus
ACR_NAME=
CONTAINERAPPS_ENV=
PG_SERVER_NAME=
# Recursos de correo del paso 7 (ej. dns-comm / dns-email):
ACS_RESOURCE_NAME=
ACS_EMAIL_SERVICE_NAME=

# --- Base de datos: PostgreSQL Flexible Server (paso 5) ---
# DB_HOST tiene la forma <PG_SERVER_NAME>.postgres.database.azure.com
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
POSTGRES_USER=
POSTGRES_PASSWORD=          # SECRETO (pgpass)
DB_EXTRA_PARAMS=&sslmode=require
# 'always' SOLO en el primer arranque de customer-service; luego 'never'
SQL_INIT_MODE=never

# --- Kafka: Confluent Cloud (paso 6) ---
# Bootstrap con forma pkc-xxxxx.eastus.azure.confluent.cloud:9092
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=PLAIN
# Cadena JAAS completa con la API key/secret del CLUSTER:
# org.apache.kafka.common.security.plain.PlainLoginModule required username="<KEY>" password="<SECRET>";
KAFKA_SASL_JAAS_CONFIG=     # SECRETO (kafkajaas)

# --- Schema Registry: Confluent Cloud (paso 6.4/6.5) ---
# URL con forma https://psrc-xxxxx.eastus.azure.confluent.cloud
SCHEMA_REGISTRY_URL=
# Formato <SR_KEY>:<SR_SECRET> (API key propia del Schema Registry)
SCHEMA_REGISTRY_AUTH_USER_INFO=   # SECRETO (srauth)

# --- Correo: Azure Communication Services (paso 7) ---
# Solo aplican a notification-service. Ver guia, seccion 7.4.
# MAIL_PROVIDER puede omitirse: 'azure' es el default de la aplicacion
MAIL_PROVIDER=azure
# Connection string del recurso dns-comm (paso 7.3a). Forma:
#   endpoint=https://<recurso>.unitedstates.communication.azure.com/;accesskey=...
# Obligatoria con provider azure: el servicio NO ARRANCA sin ella.
ACS_CONNECTION_STRING=      # SECRETO (acsconn)
# Remitente: donotreply@ + el fromSenderDomain del paso 7.3b.
# Con dominio gestionado, 'donotreply' es el unico usuario permitido.
MAIL_FROM=
# Rate limiter interno (token bucket): N correos por intervalo.
# Default de la app: 5 / 20000 (~15/min, pensado para Gmail); con ACS puede subirse:
MAIL_RATE_LIMIT_TOKENS=20
MAIL_RATE_LIMIT_REFILL_MS=1000
# Espera maxima por la confirmacion de envio de ACS (default 60, puede omitirse):
# ACS_EMAIL_TIMEOUT_SECONDS=60

# Alternativa SMTP (Gmail para demos / Mailpit para pruebas de carga).
# Solo aplica si cambias MAIL_PROVIDER=smtp; con provider azure se ignoran:
# MAIL_HOST=smtp.gmail.com          # (Mailpit: mailpit)
# MAIL_PORT=587                     # (Mailpit: 1025)
# MAIL_USERNAME=
# MAIL_PASSWORD=                    # SECRETO — App Password de Gmail
# MAIL_SMTP_AUTH=true               # (Mailpit: false)
# MAIL_SMTP_STARTTLS_ENABLE=true    # (Mailpit: false)
# MAIL_SMTP_STARTTLS_REQUIRED=true  # (Mailpit: false)

# --- Operacion ---
APP_LOG_LEVEL=INFO
JPA_SHOW_SQL=false

# --- Escalado (solo si subes replicas; ver seccion de escalado) ---
# Unico por instancia de notification-service (locking del outbox):
# NOTIFICATION_INSTANCE_ID=
# Pool por replica si te quedas en la BD B1ms (~35 conexiones max):
# SPRING_DATASOURCE_HIKARI_MAXIMUMPOOLSIZE=5
