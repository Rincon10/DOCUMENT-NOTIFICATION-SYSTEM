# ============================================================
# Variables de entorno para docker-compose (copiar a .env)
# En la nube, estas mismas variables se inyectan via el
# orquestador (K8s ConfigMap/Secret, ECS task def, etc.)
# ============================================================

# --- Escalado local ---
GENERATOR_REPLICAS=1
NOTIFICATION_REPLICAS=1

# --- Correo (notification-service) ---
MAIL_FROM=no-reply@example.com
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=no-reply@example.com
MAIL_PASSWORD=

# --- Base de datos (managed Postgres en la nube) ---
# DB_HOST=postgres
# DB_PORT=5432
# DB_NAME=postgres
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=admin
# Parametros extra del JDBC URL, ej. TLS obligatorio en nubes gestionadas:
# DB_EXTRA_PARAMS=&sslmode=require

# --- Kafka (managed Kafka en la nube) ---
# KAFKA_BOOTSTRAP_SERVERS=kafka-broker-1:9092,kafka-broker-2:9092,kafka-broker-3:9092
# SCHEMA_REGISTRY_URL=http://schema-registry:8081
# KAFKA_REPLICATION_FACTOR=3
# KAFKA_NUM_PARTITIONS=3
# Seguridad para Kafka gestionado (Confluent Cloud / MSK / Event Hubs):
# KAFKA_SECURITY_PROTOCOL=SASL_SSL
# KAFKA_SASL_MECHANISM=PLAIN
# KAFKA_SASL_JAAS_CONFIG=org.apache.kafka.common.security.plain.PlainLoginModule required username="<key>" password="<secret>";
# SCHEMA_REGISTRY_AUTH_USER_INFO=<sr-key>:<sr-secret>
